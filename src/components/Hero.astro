---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { dictionaryFor, fill } from '../i18n';
import type { Locale } from '../lib/domain';

interface Props {
  locale: Locale;
  image: ImageMetadata;
  imageAlt: string;
  foundedYear: number;
  ordersCount: number;
  bookHref: string;
  pricesHref: string;
}

const { locale, image, imageAlt, foundedYear, ordersCount, bookHref, pricesHref } = Astro.props;
const t = dictionaryFor(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__image"
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    format="webp"
    quality={72}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__actions" data-hides-sticky>
      <a class="btn btn--primary" href={bookHref}>{t.cta.bookDate}</a>
      <a class="btn btn--ghost" href={pricesHref}>{t.cta.prices}</a>
    </div>
    <ul class="hero__facts">
      <li>{fill(t.hero.since, { year: foundedYear })}</li>
      <li>{fill(t.hero.orders, { count: ordersCount })}</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(calc(100svh - var(--header-height)), 52rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hero-overlay);
  }

  .hero__content {
    padding-block: var(--space-8);
  }

  .hero__content > * {
    max-width: 38rem;
  }

  h1 {
    margin-top: var(--space-4);
  }

  .hero__lead {
    margin-top: var(--space-5);
    color: var(--c-muted);
    font-size: var(--text-l);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    color: var(--c-text);
    font-size: var(--text-s);
    font-weight: 600;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__facts li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c-accent);
  }

  /* Phones: the photo on top, the text below it on the plain background. */
  @media (max-width: 720px) {
    .hero {
      display: block;
      min-height: 0;
    }

    .hero__image {
      position: relative;
      z-index: auto;
      height: 34svh;
      min-height: 13rem;
      object-position: 62% center;
    }

    .hero__overlay {
      inset: 0 0 auto;
      height: 34svh;
      min-height: 13rem;
      background: linear-gradient(0deg, var(--c-bg) 0%, transparent 30%);
    }

    .hero__content {
      position: relative;
      padding-block: var(--space-4) var(--space-7);
    }

    .eyebrow::before {
      display: none;
    }

    .eyebrow {
      letter-spacing: 0.1em;
    }

    h1 {
      margin-top: var(--space-3);
    }

    .hero__lead {
      margin-top: var(--space-4);
    }

    .hero__actions {
      margin-top: var(--space-5);
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__facts {
      margin-top: var(--space-5);
    }
  }
</style>
