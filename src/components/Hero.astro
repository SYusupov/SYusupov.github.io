---
import { existsSync, readdirSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { dictionaryFor, fill } from '../i18n';
import type { Locale } from '../lib/domain';

interface Props {
  locale: Locale;
  /** The poster: a frame of the first clip; it stays when no clip plays. */
  image: ImageMetadata;
  imageAlt: string;
  foundedYear: number;
  ordersCount: number;
  bookHref: string;
  pricesHref: string;
}

const { locale, image, imageAlt, foundedYear, ordersCount, bookHref, pricesHref } = Astro.props;
const t = dictionaryFor(locale);

// Tall (9:16) clips of the first screen, played one after another: public/media/hero-<n>.mp4
// (720×1280, computers) and hero-<n>-s.mp4 (540×960, phones). Made by `tsx scripts/prepare-hero.ts`.
const clips = existsSync('public/media')
  ? readdirSync('public/media')
      .map((name) => /^hero-(\d+)\.mp4$/.exec(name)?.[1])
      .filter((n): n is string => n !== undefined)
      .map(Number)
      .sort((a, b) => a - b)
      .map((n) => ({
        large: `/media/hero-${n}.mp4`,
        small: existsSync(`public/media/hero-${n}-s.mp4`) ? `/media/hero-${n}-s.mp4` : `/media/hero-${n}.mp4`,
      }))
  : [];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content" data-hero-content>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__actions" data-hides-sticky>
        <a class="btn btn--primary" href={bookHref}>{t.cta.bookDate}</a>
        <a class="btn btn--ghost" href={pricesHref}>{t.cta.prices}</a>
      </div>
      <ul class="hero__facts">
        <li>{fill(t.hero.since, { year: foundedYear })}</li>
        <li>{fill(t.hero.orders, { count: ordersCount })}</li>
      </ul>
    </div>
    <div class="hero__media" data-hero-media>
      <Image
        class="hero__image"
        src={image}
        alt={imageAlt}
        widths={[400, 640, 960]}
        sizes="(max-width: 860px) 66vw, 27rem"
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
      />
      {
        clips.map((clip) => (
          <video
            class="hero__video"
            muted
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
            data-hero-video
            data-large={clip.large}
            data-small={clip.small}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  // The clips start only after the page has loaded, one after another with a soft crossfade, and
  // never with data saving or reduced motion: then, and until the first one plays, the photo stays.
  // A clip off screen is paused.
  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-hero-video]')];
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const calm =
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    connection?.saveData === true ||
    /(^|-)2g$/.test(connection?.effectiveType ?? '');
  if (videos.length && media && !calm) {
    const phone = matchMedia('(max-width: 860px)').matches;
    let current = 0;
    let visible = true;
    const load = (video: HTMLVideoElement) => {
      if (video.getAttribute('src')) return;
      video.src = (phone ? video.dataset.small : video.dataset.large) ?? '';
      video.load();
    };
    const show = (index: number) => videos.forEach((video, i) => video.classList.toggle('is-playing', i === index));
    const play = (index: number) => {
      current = index;
      const video = videos[index];
      load(video);
      video.currentTime = 0;
      if (visible) video.play().catch(() => {});
    };
    videos.forEach((video, index) => {
      video.loop = videos.length === 1;
      video.addEventListener('playing', () => {
        show(index);
        // The next clip is fetched once this one runs, not before.
        load(videos[(index + 1) % videos.length]);
      });
      video.addEventListener('ended', () => play((index + 1) % videos.length));
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) videos[current].play().catch(() => {});
      else videos[current].pause();
    }).observe(media);
    const start = () => play(0);
    const later = () => ('requestIdleCallback' in window ? requestIdleCallback(start) : setTimeout(start, 800));
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  }
</script>

<style>
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-8);
    min-height: min(calc(100svh - var(--header-height)), 52rem);
    padding-block: var(--space-6);
  }

  .hero__content > * {
    max-width: 38rem;
  }

  h1 {
    margin-top: var(--space-4);
  }

  .hero__lead {
    margin-top: var(--space-5);
    color: var(--c-muted);
    font-size: var(--text-l);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    color: var(--c-text);
    font-size: var(--text-s);
    font-weight: 600;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__facts li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c-accent);
  }

  /* Computers: the tall clip in a rounded frame beside the text, as high as the first screen allows. */
  .hero__media {
    position: relative;
    height: min(46rem, calc(100svh - var(--header-height) - 3rem));
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--c-surface-2);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }

  .hero__image,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Phones and tablets: the clip on top, the text under it on the plain background. */
  @media (max-width: 860px) {
    .hero__inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-block: var(--space-3) var(--space-7);
    }

    .hero__inner {
      align-items: center;
    }

    /* Tall enough to hold the whole fountain of the first clip, but not the whole screen. */
    .hero__media {
      order: -1;
      width: 100%;
      height: clamp(18rem, 64svh, 36rem);
      aspect-ratio: auto;
      box-shadow: none;
    }

    .hero__content {
      width: 100%;
      max-width: 38rem;
      padding-top: var(--space-5);
    }

    .eyebrow::before {
      display: none;
    }

    .eyebrow {
      letter-spacing: 0.1em;
    }

    h1 {
      margin-top: var(--space-3);
    }

    .hero__lead {
      margin-top: var(--space-4);
    }

    .hero__actions {
      margin-top: var(--space-5);
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__facts {
      margin-top: var(--space-5);
    }
  }

  /* Large phones and tablets in portrait: a centred 4:5 card instead of a very wide, cropped band. */
  @media (min-width: 521px) and (max-width: 860px) {
    .hero__media {
      width: min(100%, 26rem);
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
