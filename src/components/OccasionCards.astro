---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { dictionaryFor } from '../i18n';
import type { EventEntry } from '../lib/content';
import { OCCASION_TYPES, type Locale } from '../lib/domain';
import { pathFor } from '../lib/routes';

interface Props {
  locale: Locale;
  /** Newest first: each card shows the cover of the latest event of its type. */
  events: EventEntry[];
  fallbackImage: ImageMetadata;
}

const { locale, events, fallbackImage } = Astro.props;
const t = dictionaryFor(locale);
const cards = OCCASION_TYPES.map((type) => ({
  type,
  href: pathFor(locale, { kind: 'occasion', type }),
  image: events.find((event) => event.data.type === type)?.data.cover ?? fallbackImage,
}));
---

<ul class="occasions" role="list">
  {
    cards.map((card) => (
      <li>
        <a class="occasion-card" href={card.href}>
          <Image
            src={card.image}
            alt=""
            widths={[400, 800]}
            sizes="(max-width: 720px) 45vw, 380px"
            format="webp"
            quality={70}
            loading="lazy"
          />
          <span class="occasion-card__name">{t.eventTypes[card.type]}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .occasions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .occasion-card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-l);
    background: var(--c-surface-2);
    color: #fbf4ea;
    text-decoration: none;
    isolation: isolate;
  }

  .occasion-card :global(img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .occasion-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(42 18 8 / 0.78) 0%, rgb(42 18 8 / 0.1) 60%);
  }

  .occasion-card:hover :global(img) {
    transform: scale(1.05);
  }

  .occasion-card__name {
    position: absolute;
    inset: auto var(--space-5) var(--space-4);
    font-family: var(--font-display), Georgia, serif;
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.15;
  }

  .occasion-card__name::after {
    content: ' →';
  }

  @media (max-width: 720px) {
    .occasions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .occasion-card__name {
      inset: auto var(--space-3) var(--space-3);
      font-size: 1.05rem;
    }
  }
</style>
