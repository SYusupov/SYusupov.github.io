---
interface Props {
  label: string;
  href: string;
  external?: boolean;
}

const { label, href, external = false } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta>
  <a class="btn btn--primary" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
    {label}
  </a>
</div>

<script>
  // On phones the bar steps aside while another booking button (marked data-hides-sticky)
  // is at least half on screen, so the same action never shows twice.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const buttons = document.querySelectorAll('[data-hides-sticky]');
  if (bar && buttons.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.intersectionRatio >= 0.5) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        bar.classList.toggle('is-hidden', visible.size > 0);
      },
      { threshold: [0, 0.5, 1] },
    );
    buttons.forEach((button) => observer.observe(button));
  }
</script>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 720px) {
    .sticky-cta {
      position: fixed;
      inset: auto 0 0;
      z-index: 60;
      display: flex;
      gap: var(--space-2);
      padding: var(--space-3) 1rem calc(var(--space-3) + env(safe-area-inset-bottom));
      background: var(--c-header-bg);
      border-top: 1px solid var(--c-line);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transition: transform 0.3s var(--ease);
    }

    .sticky-cta.is-hidden {
      transform: translateY(110%);
    }

    .sticky-cta .btn {
      flex: 1;
    }

    :global(body) {
      padding-bottom: 5rem;
    }
  }
</style>
