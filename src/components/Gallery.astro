---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { dictionaryFor, fill } from '../i18n';
import type { Locale } from '../lib/domain';

interface Props {
  locale: Locale;
  photos: { image: ImageMetadata; alt: string }[];
  videos: { src: string; poster: string; label: string }[];
}

const { locale, photos, videos } = Astro.props;
const t = dictionaryFor(locale);
// A couple of clips open the gallery; with many of them the photos come first, or the clips would fill the screens.
const videosLast = videos.length > 6;
// Phones: `sizes` is set below the real width on purpose, so 3× screens fetch ~2× images (half the bytes).
---

<ul class="gallery" role="list" data-gallery data-videos-last={videosLast ? '' : undefined}>
  {
    videos.map((video) => (
      <li class="gallery__item gallery__item--video">
        <video muted loop playsinline preload="none" poster={video.poster} aria-label={video.label} data-autoplay>
          <source src={video.src} type="video/mp4" />
        </video>
      </li>
    ))
  }
  {
    photos.map((photo, index) => (
      <li class="gallery__item">
        <a href={photo.image.src} data-lightbox-item aria-label={fill(t.lightbox.open, { n: index + 1 })}>
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 720px) 33vw, (max-width: 1100px) 33vw, 380px"
            format="webp"
            quality={72}
            loading="lazy"
          />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" data-lightbox data-counter={t.lightbox.counter} aria-label={t.eventPage.gallery}>
  <figure class="lightbox__figure">
    <img class="lightbox__image" data-lightbox-image alt="" />
    <figcaption class="lightbox__counter" data-lightbox-counter></figcaption>
  </figure>
  <button type="button" class="lightbox__button lightbox__close" data-lightbox-close aria-label={t.lightbox.close}>×</button>
  <button type="button" class="lightbox__button lightbox__prev" data-lightbox-prev aria-label={t.lightbox.previous}>‹</button>
  <button type="button" class="lightbox__button lightbox__next" data-lightbox-next aria-label={t.lightbox.next}>›</button>
</dialog>

<script>
  import { fill } from '../lib/template';

  // Videos play silently while at least half on screen; with reduced motion they wait for a tap.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  if (reduceMotion) videos.forEach((video) => (video.controls = true));
  else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => (video.controls = true));
          else video.pause();
        }
      },
      { threshold: 0.5 },
    );
    videos.forEach((video) => observer.observe(video));
  }

  // Photos open full size in a dialog: buttons, arrow keys and swipes move between them.
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-item]')];
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const counter = dialog?.querySelector('[data-lightbox-counter]');
  if (dialog && image && counter && links.length && typeof dialog.showModal === 'function') {
    let current = 0;
    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      counter.textContent = fill(dialog.dataset.counter ?? '', { n: current + 1, total: links.length });
    };
    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(index);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    let touchX: number | null = null;
    dialog.addEventListener('touchstart', (event) => (touchX = event.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      if (touchX === null) return;
      const distance = event.changedTouches[0].clientX - touchX;
      if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
      touchX = null;
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--c-surface-2);
    aspect-ratio: 4 / 3;
  }

  .gallery__item--video {
    grid-row: span 2;
    aspect-ratio: auto;
  }

  .gallery[data-videos-last] .gallery__item--video {
    order: 1;
  }

  .gallery__item a {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }

  .gallery__item :global(img),
  .gallery__item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  /* Most photos are portrait phone shots cropped to 4:3: keep the top of the fountain, not the table's front edge. */
  .gallery__item :global(img) {
    object-position: 50% 30%;
  }

  .gallery__item a:hover :global(img) {
    transform: scale(1.03);
  }

  @media (max-width: 720px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 9 5 / 0.94);
    color: #fbf4ea;
  }

  .lightbox::backdrop {
    background: rgb(20 9 5 / 0.6);
  }

  .lightbox__figure {
    display: grid;
    place-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-7) var(--space-4);
  }

  .lightbox__image {
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    object-fit: contain;
    border-radius: var(--radius-s);
  }

  .lightbox__counter {
    font-size: var(--text-s);
    opacity: 0.8;
  }

  .lightbox__button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgb(251 244 234 / 0.14);
    color: inherit;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__button:hover {
    background: rgb(251 244 234 / 0.26);
  }

  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }

  .lightbox__prev {
    top: 50%;
    left: var(--space-4);
    transform: translateY(-50%);
  }

  .lightbox__next {
    top: 50%;
    right: var(--space-4);
    transform: translateY(-50%);
  }
</style>
