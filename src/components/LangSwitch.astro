---
import { dictionaryFor } from '../i18n';
import { LOCALES, type Locale } from '../lib/domain';
import { pathFor, type Page } from '../lib/routes';

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const t = dictionaryFor(locale);
---

<nav class="lang-switch" data-lang-switch aria-label={t.langSwitchLabel}>
  <ul>
    {
      LOCALES.map((other) => {
        const names = dictionaryFor(other);
        return (
          <li>
            {other === locale ? (
              <span aria-current="true" lang={other} title={names.langName}>
                {names.langShort}
              </span>
            ) : (
              <a href={pathFor(other, page)} hreflang={other} lang={other} title={names.langName}>
                {names.langShort}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: 2px;
    padding: 3px;
    list-style: none;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
  }

  a,
  span {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.25rem;
    padding-inline: 0.5rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  a {
    color: var(--c-muted);
  }

  a:hover {
    color: var(--c-text);
  }

  span {
    background: var(--c-chip-bg);
    color: var(--c-chip-text);
  }
</style>
