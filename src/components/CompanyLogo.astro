---
import { Image } from 'astro:assets';
import type { CompanyEntry } from '../lib/content';

interface Props {
  company: CompanyEntry;
  height?: number;
  /** A page of this site about the company's events; it wins over the company's own site. */
  href?: string;
  /** What the link to `href` says to screen readers. */
  label?: string;
}

const { company, height = 56, href, label } = Astro.props;
const logo = company.data.logo;
const url = company.data.url;
// The logo leads to the company's events on this site (same tab); without events, to the company's
// own site: a new tab, no referrer, no search weight.
const Wrapper = href || url ? 'a' : 'span';
const link = href
  ? { href, 'aria-label': label }
  : url
    ? { href: url, target: '_blank', rel: 'noopener noreferrer nofollow' }
    : {};
---

{
  logo && (
    <Wrapper class="company-logo" {...link}>
      {logo.format === 'svg' ? (
        <img
          src={logo.src}
          alt={company.data.name}
          height={height}
          width={Math.round((height * logo.width) / logo.height)}
          loading="lazy"
        />
      ) : (
        <Image src={logo} alt={company.data.name} height={height} densities={[1, 2]} format="webp" loading="lazy" />
      )}
    </Wrapper>
  )
}

<style>
  .company-logo {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
</style>
