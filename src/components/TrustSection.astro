---
import { dictionaryFor, fill } from '../i18n';
import type { CompanyEntry } from '../lib/content';
import type { Locale } from '../lib/domain';
import CompanyLogo from './CompanyLogo.astro';

interface Props {
  locale: Locale;
  /** Companies with a logo; the block is left out while there are none. */
  companies: CompanyEntry[];
}

const { locale, companies } = Astro.props;
const t = dictionaryFor(locale);
const WALL_SIZE = 30;
const first = companies.slice(0, WALL_SIZE);
const rest = companies.slice(WALL_SIZE);
---

{
  companies.length > 0 && (
    <section class="section trust" data-trust aria-labelledby="trust-title">
      <div class="container">
        <div class="section-head">
          <div class="section-head__text">
            <h2 id="trust-title">{t.trust.title}</h2>
            <p>{t.trust.lead}</p>
          </div>
        </div>
        <ul class="trust__wall" role="list">
          {first.map((company) => (
            <li class="trust__logo">
              <CompanyLogo company={company} />
            </li>
          ))}
        </ul>
        {rest.length > 0 && (
          <details class="trust__more">
            <summary>{fill(t.trust.showAll, { count: companies.length })}</summary>
            <ul class="trust__wall" role="list">
              {rest.map((company) => (
                <li class="trust__logo">
                  <CompanyLogo company={company} />
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </section>
  )
}

<style>
  .trust__wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .trust__logo {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    padding: var(--space-4);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-m);
    background: var(--c-surface);
  }

  .trust__logo :global(img) {
    max-width: 100%;
    max-height: 3.5rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .trust__logo:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  .trust__more {
    margin-top: var(--space-4);
  }

  .trust__more summary {
    width: fit-content;
    margin-bottom: var(--space-4);
    color: var(--c-accent-text);
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .trust__wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
