---
interface Props {
  label: string;
  items: { name: string; href?: string }[];
}

const { label, items } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {
      items.map((item) => (
        <li>{item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    color: var(--c-muted);
    font-size: var(--text-s);
  }

  li + li::before {
    content: '/';
    margin-right: var(--space-2);
    opacity: 0.6;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--c-text);
    text-decoration: underline;
  }
</style>
