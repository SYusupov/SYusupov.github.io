---
import { Image } from 'astro:assets';
import { dictionaryFor } from '../i18n';
import type { EventEntry } from '../lib/content';
import type { Locale } from '../lib/domain';
import { eventPhotoAlt, eventTitle } from '../lib/event-title';
import { pathFor } from '../lib/routes';

interface Props {
  event: EventEntry;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { event, locale, headingLevel = 'h3' } = Astro.props;
const t = dictionaryFor(locale);
const Heading = headingLevel;
// Phones: `sizes` is set below the real width on purpose, so 3× screens fetch ~2× images (half the bytes).
---

<article class="event-card">
  <a class="event-card__link" href={pathFor(locale, { kind: 'event', slug: event.id })}>
    <div class="event-card__media">
      <Image
        src={event.data.cover}
        alt={eventPhotoAlt(event.data, locale, 1)}
        widths={[400, 640, 960]}
        sizes="(max-width: 720px) 55vw, (max-width: 1000px) 45vw, 380px"
        format="webp"
        quality={62}
        loading="lazy"
      />
      {event.data.videos.length > 0 && <span class="event-card__badge">▶ {t.eventsPage.video}</span>}
    </div>
    <div class="event-card__body">
      <Heading class="event-card__title">{eventTitle(event.data, locale)}</Heading>
      {event.data.venue && <p class="event-card__subtitle">{event.data.venue}</p>}
    </div>
  </a>
</article>

<style>
  .event-card {
    height: 100%;
  }

  .event-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-surface);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .event-card__link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .event-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-surface-2);
  }

  .event-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform 0.6s var(--ease);
  }

  .event-card__link:hover .event-card__media :global(img) {
    transform: scale(1.04);
  }

  .event-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgb(42 18 8 / 0.72);
    color: #fbf4ea;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .event-card__body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-5);
  }

  .event-card__title {
    margin-top: var(--space-1);
    font-family: var(--font-display), Georgia, serif;
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.15;
  }

  .event-card__subtitle {
    color: var(--c-muted);
    font-size: var(--text-s);
  }
</style>
