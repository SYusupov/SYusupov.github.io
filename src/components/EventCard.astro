---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  dateLabel: string;
  subtitle?: string;
  eager?: boolean;
}

const { href, image, imageAlt, title, dateLabel, subtitle, eager = false } = Astro.props;
---

<article class="event-card">
  <a class="event-card__link" href={href}>
    <div class="event-card__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 960]}
        sizes="(max-width: 720px) 82vw, (max-width: 1000px) 45vw, 380px"
        format="webp"
        quality={72}
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
    <div class="event-card__body">
      <span class="chip">{dateLabel}</span>
      <h3>{title}</h3>
      {subtitle && <p class="event-card__subtitle">{subtitle}</p>}
    </div>
  </a>
</article>

<style>
  .event-card {
    height: 100%;
  }

  .event-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-surface);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .event-card__link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .event-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .event-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .event-card__link:hover .event-card__media :global(img) {
    transform: scale(1.04);
  }

  .event-card__body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-5);
  }

  h3 {
    margin-top: var(--space-1);
  }

  .event-card__subtitle {
    color: var(--c-muted);
    font-size: var(--text-s);
  }
</style>
