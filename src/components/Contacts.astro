---
import { dictionaryFor, fill } from '../i18n';
import type { Locale } from '../lib/domain';
import { formatPhone } from '../lib/format';
import type { SiteSettings } from '../lib/schemas';

interface Props {
  locale: Locale;
  site: SiteSettings;
}

const { locale, site } = Astro.props;
const t = dictionaryFor(locale);
const name = site.contactName[locale] ?? site.contactName.ru;
// Telegram first, then the phone, then Instagram: the order the owner chose.
const channels = [
  { label: t.contacts.telegram, value: `@${site.telegram}`, action: t.contacts.telegramAction, href: `https://t.me/${site.telegram}`, external: true },
  { label: t.contacts.phone, value: formatPhone(site.phone), action: t.contacts.phoneAction, href: `tel:${site.phone}`, external: false },
  ...(site.instagram
    ? [{ label: t.contacts.instagram, value: `@${site.instagram}`, action: t.contacts.instagramAction, href: `https://instagram.com/${site.instagram}`, external: true }]
    : []),
];
---

<section class="section section--alt" id="contacts" aria-labelledby="contacts-title">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <h2 id="contacts-title">{t.contacts.title}</h2>
        <p>{t.contacts.lead}</p>
      </div>
    </div>
    <ul class="channels" role="list">
      {
        channels.map((channel, index) => (
          <li class:list={['channel', { 'channel--main': index === 0 }]}>
            <span class="channel__label">{channel.label}</span>
            <span class="channel__value">{channel.value}</span>
            <a
              class:list={['btn', index === 0 ? 'btn--primary' : 'btn--ghost']}
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener' : undefined}
            >
              {channel.action}
            </a>
          </li>
        ))
      }
    </ul>
    {name && <p class="contacts__manager">{fill(t.contacts.manager, { name })} · {t.contacts.city}</p>}
  </div>
</section>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .channel {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-surface);
  }

  .channel--main {
    border-color: var(--c-accent);
    box-shadow: inset 0 0 0 1px var(--c-accent);
  }

  .channel__label {
    color: var(--c-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .channel__value {
    font-family: var(--font-display), Georgia, serif;
    font-size: var(--text-h3);
    font-weight: 600;
    font-variant-numeric: lining-nums;
  }

  .channel .btn {
    margin-top: var(--space-3);
  }

  .contacts__manager {
    margin-top: var(--space-5);
    color: var(--c-muted);
  }

  @media (max-width: 860px) {
    .channels {
      grid-template-columns: 1fr;
    }

    .channel .btn {
      width: 100%;
    }
  }
</style>
