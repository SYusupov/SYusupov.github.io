---
import type { GetStaticPaths } from 'astro';
import { getEvents } from '../../../lib/content';
import { PREFIXED_LOCALES, type Locale } from '../../../lib/domain';
import EventPage from '../../../views/EventPage.astro';

export const getStaticPaths = (async () => {
  const events = await getEvents();
  return PREFIXED_LOCALES.flatMap((locale) =>
    events.map((event) => ({ params: { locale, slug: event.id }, props: { event } })),
  );
}) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const { event } = Astro.props;
---

<EventPage locale={locale} event={event} />
